# ── API Configuration ──────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ── Model Configuration ────────────────────────────────────────────────────────
PERSUASION_MODEL_PATH=checkpoints/persuasion_roberta_best.pt
GNN_MODEL_PATH=checkpoints/gnn_model.pt
GRAPH_PATH=checkpoints/news_graph.pkl

# ── Responsible Ranking ────────────────────────────────────────────────────────
ALPHA=0.7          # Weight for relevance (0.0–1.0)
BETA=0.3           # Weight for persuasion risk (0.0–1.0)
PROVIDER_CAP=0.30  # Max fraction from a single news provider

# ── Dataset Paths ─────────────────────────────────────────────────────────────
MIND_TRAIN_DIR=data/raw/mind/train
MIND_DEV_DIR=data/raw/mind/dev
SEMEVAL_DIR=data/raw/semeval2023
GOEMOTIONS_DIR=data/raw/goEmotions
CLICKBAIT_DIR=data/raw/clickbait

# ── Experiment Tracking ───────────────────────────────────────────────────────
WANDB_PROJECT=responsible-news-recommender
WANDB_API_KEY=your_wandb_api_key_here

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=your_huggingface_token_here
